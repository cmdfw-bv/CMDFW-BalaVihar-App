# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# local agent / governance state (do not commit)
.claude/settings.local.json
.claude/.rls-tests-passed
.claude/.instructions-loaded.log
.playwright-cli/

# secrets / local env (keep .env.example)
.env
.env.*
!.env.example

# local supabase
supabase/.branches
supabase/.temp

# netlify
.netlify

# misc
*.log

# supabase edge-runtime local artifact (we use netlify functions, not edge fns)
deno.lock
