{
  "$schema": "od-design-tokens/v1",
  "meta": {
    "name": "Sankalp — Chinmaya Mission DFW",
    "description": "Token source of truth for the CMDFW Bala Vihar Connect app. Exported from the Chinmaya Mission Design System. Consumed by scripts/gen-theme.mjs -> lib/theme.ts (Unistyles 3, ADR-0011). Do not hand-tune lib/theme.ts; edit this file and run `npm run gen:theme`.",
    "brand": {
      "action": "One terracotta CTA color (color.accent). indigo + gold are identity/atmosphere ONLY and never a second action color.",
      "status": "The status ramp means exactly one thing each (present/absent/excused/info + soft/line variants).",
      "role": "Six role hues code personas for DATA ONLY — never a page background or action color.",
      "type": "Marcellus is single-weight (400). Build hierarchy with size + color, never synthetic bold. Body emphasis switches Mukta family (medium/semibold), never fontWeight on display."
    }
  },

  "color": {
    "_comment": "v1 stable aliases (bg/accent/brand/status/role) are preserved for the od-design-tokens/v1 contract. Everything else is the full brand + app layer the components need. Values verbatim from the design system tokens (colors.css + bv-connect/tokens/app.css).",

    "bg": "#f7f1e6",
    "accent": "#b8531a",
    "brand": "#b8893f",

    "bgCream": "#fbf6eb",
    "surface": "#fffaf0",
    "surfaceAlt": "#f1e8d4",

    "ink": "#1c1410",
    "ink2": "#3d2e22",
    "ink3": "#6b574a",
    "ink4": "#9c8773",
    "line": "#e6d8bf",
    "line2": "#d6c4a3",

    "accentPressed": "#8e3d10",
    "accentSoft": "#f3d9b8",

    "indigo": "#2d2056",
    "indigo2": "#1a1238",
    "gold": "#b8893f",
    "gold2": "#8a6320",
    "goldLight": "#f6c98a",

    "onAction": "#fbf3df",
    "onDark": "#fbf3df",

    "status": {
      "present": "#2f6a3a",
      "presentSoft": "#e7f1e8",
      "presentLine": "#c4dec9",
      "excused": "#8a6320",
      "excusedSoft": "#fff4e0",
      "excusedLine": "#f1d59a",
      "info": "#2c4a7a",
      "infoSoft": "#f0f4fc",
      "infoLine": "#d6e0f4",
      "absent": "#b3402e",
      "absentSoft": "#f7e3df",
      "absentLine": "#e6c3bb"
    },

    "role": {
      "student": "#3f6db0",
      "parent": "#4a8a5c",
      "teacher": "#7a5ba8",
      "coordinator": "#c08a3e",
      "bv": "#a4508a",
      "admin": "#5a5566"
    },

    "app": {
      "canvas": "#f4eee1",
      "surface": "#fffdf8",
      "surface2": "#f7f0e2",
      "overlay": "rgba(28,20,16,0.46)",
      "scope": {
        "org": "{color.status.info}",
        "center": "{color.gold2}",
        "class": "{color.role.teacher}"
      },
      "chatOut": "{color.accent}",
      "chatOutInk": "#fff6ea",
      "chatIn": "{color.app.surface}",
      "chatInInk": "{color.ink}",
      "chatInLine": "{color.line}",
      "chatUnread": "{color.accent}",
      "private": "#6d4bb0",
      "privateSoft": "#efeafa",
      "privateLine": "#ddd2f3"
    }
  },

  "space": {
    "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64,
    "xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 32
  },

  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 18,
    "control": 10,
    "card": 14,
    "bubble": 18,
    "pill": 999
  },

  "type": {
    "body": 16,
    "display": 28,
    "scale": {
      "display": 80,
      "h1": 56,
      "h2": 36,
      "h3": 22,
      "lead": 18,
      "body": 16,
      "sm": 14,
      "xs": 13,
      "eyebrow": 11
    },
    "leading": { "tight": 1.05, "snug": 1.3, "body": 1.6 },
    "tracking": { "display": 0.005, "eyebrow": 0.18, "mono": 0.04 }
  },

  "font": {
    "display": "Marcellus-Regular",
    "body": "Mukta-Regular",
    "medium": "Mukta-Medium",
    "semibold": "Mukta-SemiBold",
    "bold": "Mukta-Bold",
    "mono": "JetBrainsMono-Regular"
  },

  "motion": {
    "fast": 150,
    "base": 250,
    "ease": "cubic-bezier(0.2,0.7,0.2,1)"
  },

  "chrome": {
    "header": 56,
    "tabbar": 64,
    "gutter": 16,
    "maxw": 440,
    "deskw": 1180,
    "hitMin": 44
  },

  "breakpoints": { "xs": 0, "sm": 360, "md": 768, "lg": 1024, "xl": 1440 }
}
