{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "bv-connect/components/admin/**",
              "bv-connect/components/auth/**",
              "bv-connect/components/chat/**",
              "bv-connect/components/comments/**",
              "bv-connect/components/dashboard/**",
              "bv-connect/components/feed/**",
              "bv-connect/components/navigation/**",
              "bv-connect/components/notifications/**",
              "bv-connect/components/privacy/**",
              "bv-connect/screens/desktop/**",
              "bv-connect/screens/phone/**",
              "components/brand/**",
              "components/core/**",
              "ui_kits/events-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Marcellus|Mukta|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Marcellus, Mukta, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuditEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|actor|action|target|style|key|ref|className|style|children)$/]",
        "message": "<AuditEntry> doesn't accept that prop. Declared props: time, actor, action, target, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuditEntry'] > JSXAttribute[name.name='action'] > Literal[value!=/^(?:view|edit|export|approve|delete)$/]",
        "message": "<AuditEntry> action must be one of 'view' | 'edit' | 'export' | 'approve' | 'delete'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|type|href|icon|iconRight|disabled|fullWidth|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, type, href, icon, iconRight, disabled, fullWidth, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|outline|gold|danger|dark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'outline' | 'gold' | 'danger' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|interactive|as|padding|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, interactive, as, padding, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:surface|cream|indigo)$/]",
        "message": "<Card> tone must be one of 'surface' | 'cream' | 'indigo'."
